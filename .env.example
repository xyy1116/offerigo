# 环境变量模板：复制为 .env 后填写真实值
# .env 已被 .gitignore 忽略，切勿提交到仓库
#
# 启动（仓库根目录执行）：
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build

# ---- 对外访问端口（宿主机端口，80 被占用时改这里）----
FRONTEND_PORT=8081

# ---- MySQL（compose 内会自动创建该库，表结构由后端启动时自动建立）----
DB_NAME=chuan
DB_USERNAME=root
DB_PASSWORD=change-me

# ---- JWT 签名密钥：至少 32 字节随机串，生成：openssl rand -base64 48 ----
JWT_SECRET=change-me-to-a-random-secret

# ---- 大模型（缺任一项对应功能不可用）----
# DeepSeek：岗位匹配评估、定制简历/求职信
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 阿里云百炼：对话、视觉识图、实时语音识别、向量检索（一个 key 全用）
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ---- 前端来源白名单（WebSocket 握手校验），生产写实际域名，多个用逗号分隔 ----
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:*

# ---- 可选开关 ----
# 在线演示期间不希望评委执行任意代码时设为 false（编程题只判分不运行）
EXAM_CODE_ENABLED=true
# 面试开场前是否让 AI 通过工具检索素材库/题库，生成面试官简报
AI_TOOLS_ENABLED=true